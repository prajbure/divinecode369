# Documentation only. Preserve your existing .env and never commit credentials.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:8000/auth/kite/callback
APP_TIMEZONE=Asia/Kolkata
MAX_DIFFERENCE=10
MATCH_TOLERANCE=0.01
STREAMING_ENABLED=true
QUOTE_POLL_SECONDS=10
QUOTE_STALE_SECONDS=45

# API access does not imply permission to retain, redistribute or train on data.
HISTORICAL_ENABLED=false
DATA_RETENTION_AUTHORIZED=false
INTRADAY_ENABLED=false
HISTORY_AUTO_UPDATE_ENABLED=false
IMPORT_RETRY_LIMIT=3
SNAPSHOT_INTERVAL_SECONDS=300
SNAPSHOT_RETENTION_DAYS=7
INTRADAY_RETENTION_DAYS=30
DAILY_RETENTION_DAYS=1825
# DATABASE_PATH and MODEL_DIRECTORY default to private data/ paths.

AUTO_RETRAIN_ENABLED=false
TRAINING_MIN_NEW_SESSIONS=20
BACKTEST_COST_BPS=20
# ADMIN_TOKEN is required for non-loopback administration.
ADMIN_TOKEN=

# Official 2026 NSE CM calendar is bundled in data/nse-calendar-2026.json.
# Optional manually verified overrides; do not copy bank/settlement holidays.
MARKET_HOLIDAYS=
MARKET_CALENDAR_VERIFIED_THROUGH=
MARKET_SPECIAL_SESSIONS={}

# Optional personal IPO Intelligence. Add a real key only to backend environment.
IPOGURU_API_KEY=
IPOGURU_BASE_URL=https://www.ipoguru.in/api/v2
IPOGURU_ENABLED=false
IPOGURU_CACHE_SECONDS=900
